{
  "manifest_version": 3,
  "name": "Claude Voice — Voz para Claude.ai",
  "version": "1.0.0",
  "description": "Interface de voz para claude.ai. Transcreve áudio e lê respostas automaticamente. 100% gratuito, sem API keys.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://claude.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
